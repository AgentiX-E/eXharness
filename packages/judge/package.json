{
  "name": "@exharness/judge",
  "version": "0.1.0",
  "description": "LLM-as-judge: G-Eval scoring and position-bias-corrected pairwise comparison",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../..",
    "coverage": "vitest run --coverage --root ../.."
  },
  "dependencies": {
    "@exharness/llm": "workspace:*",
    "zod": "^3.23.8"
  },
  "license": "Apache-2.0"
}
