{
  "name": "@exharness/cli",
  "version": "0.1.0",
  "description": "eXharness command-line interface — run benchmarks and self-evolution experiments from the shell (Node).",
  "type": "module",
  "bin": {
    "exharness": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --sourcemap --clean --platform node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../..",
    "coverage": "vitest run --coverage --root ../.."
  },
  "dependencies": {
    "@exharness/benchmarks": "workspace:*",
    "@exharness/eval": "workspace:*",
    "@exharness/evolution": "workspace:*",
    "@exharness/experiment": "workspace:*",
    "@exharness/harness": "workspace:*",
    "@exharness/llm": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
