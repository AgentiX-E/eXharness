{
  "name": "@exharness/mcp",
  "version": "0.1.0",
  "description": "eXharness Model Context Protocol server — zero-dependency JSON-RPC 2.0 core with typed tools (Node + browser).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --platform neutral",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../..",
    "coverage": "vitest run --coverage --root ../.."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
