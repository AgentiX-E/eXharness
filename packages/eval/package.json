{
  "name": "@exharness/eval",
  "version": "0.1.0",
  "description": "eXharness evaluation engine — high-precision statistics (t-test, effect sizes, bootstrap, SPRT) and scoring metrics, self-implemented with zero runtime dependencies (Node + browser).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --platform neutral",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
