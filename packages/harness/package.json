{
  "name": "@exharness/harness",
  "version": "0.1.0",
  "description": "eXharness harness model — the five-component execution shell (prompt / router / deterministic solver / format enforcer / validator) around an LLM, with deterministic offloading.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --platform neutral",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@exharness/llm": "workspace:*",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
